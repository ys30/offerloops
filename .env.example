# ── Injected automatically by Railway ────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname   # set by Railway Postgres plugin

# ── Required ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string           # run: openssl rand -hex 32
APP_BASE_URL=https://offerloops.com                    # your domain (no trailing slash)
API_BASE_URL=https://offerloops.com                    # same — single service

# ── AI providers ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
NVIDIA_API_KEY=nvapi-...
OPENAI_API_KEY=sk-...                                  # optional

# ── Job sources ───────────────────────────────────────────────────────
USAJOBS_API_KEY=your_key_here
USAJOBS_USER_AGENT=your@email.com

# ── OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
